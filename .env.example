# ─── Réception des leads ─────────────────────────────────────────────
# Webhook (n8n, Make, Zapier…). Reçoit le lead + UTM (dans le JSON et dans l'URL).
LEAD_WEBHOOK_URL=

# GoHighLevel — envoyés au webhook dans le JSON (private_integration_key, subaccount_id, workflow_id)
# Clé : Paramètres du sous-compte > Private Integrations
GHL_PRIVATE_INTEGRATION_KEY=
# ID du sous-compte (Location ID) — Paramètres > Infos de l'entreprise
GHL_SUBACCOUNT_ID=
# Workflow dans lequel inscrire chaque nouveau lead (optionnel)
GHL_WORKFLOW_ID=

# ─── GoHighLevel Maroc ─── utilisés quand le visiteur est au Maroc (IP).
# Si GHL_PRIVATE_INTEGRATION_KEY_MA est vide, les identifiants globaux ci-dessus sont utilisés.
GHL_PRIVATE_INTEGRATION_KEY_MA=
GHL_SUBACCOUNT_ID_MA=
GHL_WORKFLOW_ID_MA=

# true = le site crée aussi le contact dans GHL directement (doublon si le workflow le fait déjà)
GHL_SEND_DIRECT=false

# ─── Tracking ────────────────────────────────────────────────────────
# Google Tag Manager (GTM-XXXXXXX) ou Google tag / GA4 / Ads (G-XXXX, AW-XXXX)
NEXT_PUBLIC_GOOGLE_TAG_ID=
# Meta Pixel ID (chiffres uniquement)
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Chat ────────────────────────────────────────────────────────────
# Widget de chat LeadConnector (bulle). MA = visiteurs au Maroc (IP), global = tous les autres
NEXT_PUBLIC_CHAT_WIDGET_ID=
NEXT_PUBLIC_CHAT_WIDGET_ID_MA=

# URL publique du site (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://clientx.ai
